string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(profile "${CMAKE_CURRENT_BINARY_DIR}/ps2-machine-test-${nonce}")
file(MAKE_DIRECTORY "${profile}")
foreach(action save load)
  execute_process(COMMAND "${PROGRAM}" "${action}" "${profile}" RESULT_VARIABLE result TIMEOUT 35)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "PS2 state ${action} failed (${result}). Fixture: ${profile}")
  endif()
  if(action STREQUAL "save")
    file(RENAME "${profile}/old-mount" "${profile}/new-mount")
  endif()
endforeach()
file(REMOVE_RECURSE "${profile}")
