# The eight original overlays reuse one guest address range, never one DLL.
function(futari_add_overlay name)
    include("${CMAKE_SOURCE_DIR}/generated/futari/${name}/sources.cmake")
    add_library(futari_${name} SHARED ${GENERATED_SOURCES})
    target_include_directories(futari_${name} PRIVATE "${CMAKE_SOURCE_DIR}/generated/futari/${name}")
    target_compile_options(futari_${name} PRIVATE -fno-char8_t)
    target_link_libraries(futari_${name} PRIVATE rex::runtime)
    if(name STREQUAL "kiniro_abnormal")
        target_sources(futari_${name} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/audio/audio_guest_hooks.cpp")
        target_compile_definitions(futari_${name} PRIVATE FUTARI_AUDIO_DIAGNOSTIC_BUILD=1)
    endif()
    rexglue_configure_module_target(futari_${name} HOST futari)
endfunction()
foreach(module hirow_abnormal hirow_normal kiniro_abnormal kiniro_normal palm_abnormal palm_normal reco_abnormal reco_normal)
    futari_add_overlay(${module})
endforeach()
