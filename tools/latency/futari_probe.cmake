# Loaded only by the isolated measurement build, never by player CMake.
function(evac_futari_probe_targets)
  set(probe "${CMAKE_SOURCE_DIR}/tools/latency")
  file(TO_CMAKE_PATH "${EVAC_FUTARI_PROBE_DIRECTORY}" fixture)
  foreach(pair "futari|default" "futari_reco_abnormal|reco_abnormal")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 target)
    list(GET pair 1 module)
    get_target_property(original "${target}" SOURCES)
    list(FILTER original EXCLUDE REGEX "/generated/futari/${module}/")
    if(target STREQUAL "futari")
      list(REMOVE_ITEM original host.cpp)
      list(APPEND original "${fixture}/host.cpp" "${probe}/futari_probe_host.cpp")
      target_compile_definitions(${target} PRIVATE EVAC_LATENCY_HOST=1)
    endif()
    include("${fixture}/generated/${module}/sources.cmake")
    set_property(TARGET ${target} PROPERTY SOURCES ${original} ${GENERATED_SOURCES} "${fixture}/${module}-probe.cpp")
    target_include_directories(${target} BEFORE PRIVATE "${fixture}/generated/${module}" "${probe}" "${CMAKE_SOURCE_DIR}/games/futari")
  endforeach()
  set_property(TARGET cave_xbox360_input PROPERTY SOURCES
      "${fixture}/configured_input.cpp" "${CMAKE_SOURCE_DIR}/backends/xbox360/input/input_state.cpp")
  target_include_directories(cave_xbox360_input PRIVATE "${probe}" "${CMAKE_SOURCE_DIR}/backends/xbox360/input")
  target_compile_definitions(cave_xbox360_input PRIVATE EVAC_LATENCY_HOST=1)
endfunction()
cmake_language(DEFER CALL evac_futari_probe_targets)
