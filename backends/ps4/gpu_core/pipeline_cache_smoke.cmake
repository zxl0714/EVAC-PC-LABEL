string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(cache "${CMAKE_CURRENT_BINARY_DIR}/Testing/pipeline-cache-${nonce}")
foreach(pass cold warm)
  execute_process(COMMAND "${PROBE}" --pipeline-cache "${cache}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
  file(MAKE_DIRECTORY "${cache}")
  file(WRITE "${cache}/${pass}.log" "${output}\n${errors}")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${pass} GPU cache smoke failed: ${result}\n${output}\n${errors}")
  endif()
  if(pass STREQUAL warm AND NOT output MATCHES "\"operation\":\"load\",\"enabled\":true,\"accepted\":true")
    message(FATAL_ERROR "Warm GPU session did not accept the saved driver cache\n${output}")
  endif()
endforeach()
