[Unit]
Description=Back up EVAC PC LABEL ESP Ra.De. community database
After=cave-esprade.service

[Service]
Type=oneshot
User=cave-community
Group=cave-community
ExecStart=/usr/bin/python3 -B /opt/cave-community/esprade-current/server/backup.py --database /var/lib/cave-community/esprade/community.sqlite3 --directory /var/lib/cave-community/esprade/backups
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cave-community/esprade
MemoryMax=128M
