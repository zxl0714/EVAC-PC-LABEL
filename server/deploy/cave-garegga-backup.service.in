[Unit]
Description=Back up EVAC PC LABEL Battle Garegga community database
After=cave-garegga.service

[Service]
Type=oneshot
User=cave-community
Group=cave-community
ExecStart=/usr/bin/python3 -B /opt/cave-community/garegga-current/server/backup.py --database /var/lib/cave-community/garegga/community.sqlite3 --directory /var/lib/cave-community/garegga/backups
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cave-community/garegga
MemoryMax=128M
