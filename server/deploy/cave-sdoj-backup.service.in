[Unit]
Description=Back up CAVE PC Collection SDOJ community database
After=cave-sdoj.service

[Service]
Type=oneshot
User=cave-community
Group=cave-community
ExecStart=/usr/bin/python3 -B /opt/cave-community/sdoj-current/server/backup.py --database /var/lib/cave-community/sdoj/community.sqlite3 --directory /var/lib/cave-community/sdoj/backups
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cave-community/sdoj
MemoryMax=128M
