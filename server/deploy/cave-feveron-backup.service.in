[Unit]
Description=Back up EVAC PC LABEL Dangun Feveron community database
After=cave-feveron.service

[Service]
Type=oneshot
User=cave-community
Group=cave-community
ExecStart=/usr/bin/python3 -B /opt/cave-community/feveron-current/server/backup.py --database /var/lib/cave-community/feveron/community.sqlite3 --directory /var/lib/cave-community/feveron/backups
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cave-community/feveron
MemoryMax=128M
