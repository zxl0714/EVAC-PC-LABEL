# Include inside the existing xiaolu.life HTTPS server block.
# Reuse the site's existing futari_requests and ketsui_requests rate zones.
location /cave/api/v1/games/espgaluda2/ {
    limit_req zone=futari_requests burst=20 nodelay;
    limit_req_status 429;
    limit_req_log_level info;
    client_max_body_size 12m;
    proxy_pass http://127.0.0.1:18086;
    proxy_connect_timeout 2s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    proxy_hide_header Server;
}
location /cave/api/v1/games/futari/ {
    limit_req zone=futari_requests burst=20 nodelay;
    limit_req_status 429;
    limit_req_log_level info;
    client_max_body_size 12m;
    proxy_pass http://127.0.0.1:18084/futari/api/v1/;
    proxy_connect_timeout 2s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    proxy_hide_header Server;
}
