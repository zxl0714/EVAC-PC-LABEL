[Unit]
Description=EVAC PC LABEL ESP Ra.De. community API
After=network.target

[Service]
Type=simple
User=cave-community
Group=cave-community
WorkingDirectory=/opt/cave-community/esprade-current
ExecStart=/usr/bin/python3 -B -m server.games.esprade --database /var/lib/cave-community/esprade/community.sqlite3 --port 18089
Restart=on-failure
RestartSec=3
StateDirectory=cave-community/esprade
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cave-community/esprade
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=384M
TasksMax=32
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
