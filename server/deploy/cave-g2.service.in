[Unit]
Description=CAVE PC Collection ESPGaluda II community API
After=network.target

[Service]
Type=simple
User=cave-community
Group=cave-community
WorkingDirectory=/opt/cave-community/current
ExecStart=/usr/bin/python3 -B -m server.games.espgaluda2 --database /var/lib/cave-community/espgaluda2/community.sqlite3 --port 18086
Restart=on-failure
RestartSec=3
StateDirectory=cave-community/espgaluda2
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cave-community/espgaluda2
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=384M
TasksMax=32
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
